# ---- Application ----
APP_NAME="Bulk Certificate Generator API"
ENVIRONMENT=development
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000          # used to build QR verification URLs

# ---- MongoDB ----
Atlas example: mongodb+srv://<abhinandanmahanta295_db_user>:v0O3cI3brxQ0Rbn7@cluster0.zqcukqr.mongodb.net/?appName=Cluster0
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=certificate_db

# ---- Certificates ----
ORGANIZATION_NAME="Example Academy"
CERTIFICATES_DIR=certificates
TEMPLATE_PATH=templates/certificate_template.png

# ---- Storage (local | s3) ----
STORAGE_BACKEND=local
# S3_BUCKET=my-bucket
# S3_REGION=ap-south-1

# ---- Auth (JWT) ----
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120
